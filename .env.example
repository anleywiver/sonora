# Database
DATABASE_URL=postgres://sonora:sonora_dev_password@postgres:5432/sonora?sslmode=disable

# Redis
REDIS_URL=redis:6379

# Meilisearch
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=dev_master_key_change_in_production

# JWT
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string

# Google OAuth (buat di Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Frontend URL - tujuan redirect setelah OAuth callback selesai
FRONTEND_URL=http://localhost:3000

# Admin URL - target redirect OAuth kalau login dari admin app (?app=admin)
ADMIN_URL=http://localhost:3001

# Sprint 14 - domain asli VPS produksi (dipakai Nginx + certbot,
# infrastructure/nginx/README.md). Kosongkan untuk dev lokal.
FRONTEND_DOMAIN=
ADMIN_DOMAIN=
API_DOMAIN=
# Build-time saja (NEXT_PUBLIC_* di-inline ke bundle client) - isi dengan
# https://${API_DOMAIN}/api/v1 di produksi.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Sprint 14 sisipan - nomor WhatsApp Owner untuk link "Request akses" di
# Login (bukan secret, PUBLIC karena dipakai client-side - format
# internasional tanpa tanda +).
NEXT_PUBLIC_OWNER_WHATSAPP=628xxxxxxxxxx

# Storage encryption (AES-256 key untuk enkripsi credential storage_accounts, STEP 4 refinement)
STORAGE_CREDENTIALS_ENCRYPTION_KEY=

# Ingest (Sprint 3) - direktori sementara file upload sebelum diproses worker,
# harus volume yang sama antara api dan worker (lihat docker-compose.yml)
INGEST_TMP_DIR=/data/ingest-tmp
